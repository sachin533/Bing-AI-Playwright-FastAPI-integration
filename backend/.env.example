# ---------------------------------------------------------------------------
# Bing AI Playwright backend - example environment file
#
# Copy to backend/.env and adjust. NEVER commit the real .env.
#   copy backend\.env.example backend\.env
# ---------------------------------------------------------------------------

# --- Server ---------------------------------------------------------------
HOST=127.0.0.1
PORT=8000
DEBUG=false
LOG_LEVEL=INFO
# Optional path for a log file (leave empty to log to stdout only)
# LOG_FILE=E:\CyberF\Day9\Bing AI Playwright\logs\backend.log

# --- Security -------------------------------------------------------------
# Comma separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000
# Optional shared secret. When set, callers must send the header
# "X-API-Key: <value>". Leave empty to disable the check (local use only).
# API_KEY=change-me

# --- Bing AI / Playwright -------------------------------------------------
# Entry point for the Bing AI web interface (Bing "AI MODE" / Copilot Search).
BING_AI_URL=https://www.bing.com/copilotsearch?q=what+is+java&FORM=CSSCOP
# Persistent browser profile. MUST live outside version control.
BROWSER_USER_DATA_DIR=E:\CyberF\Day9\Bing AI Playwright\browser_data
# false = visible window (needed for a manual Microsoft sign-in).
HEADLESS=false
BROWSER_VIEWPORT_WIDTH=1440
BROWSER_VIEWPORT_HEIGHT=900
BROWSER_LOCALE=en-US

# --- Timeouts (milliseconds unless noted) ---------------------------------
NAVIGATION_TIMEOUT_MS=60000
ACTION_TIMEOUT_MS=30000
ANSWER_TIMEOUT_MS=120000
# How long the answer text must stay unchanged to be considered finished.
STREAM_SETTLE_MS=3000
# Hard limit for one /v1/chat/completions request (seconds).
API_REQUEST_TIMEOUT_S=180

# --- Optional selector overrides ------------------------------------------
# Pipe-separated CSS selectors. Leave unset to use the defaults that were
# discovered by inspecting the live Bing AI page.
# BING_INPUT_SELECTORS=textarea[id^='b_copilot_composer']|textarea.b_copilot_composer
# BING_SUBMIT_SELECTORS=button.b_copilot_send|button[aria-label='Send']
# BING_ANSWER_SELECTORS=#b_copilot_answer|.b_copilot_answer
